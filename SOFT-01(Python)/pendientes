tabla operadores aritmeticos 


Se utilizan para realizar operaciones matemáticas.

<div style="width:100%; max-width:1000px; margin:30px auto; font-family:Arial, sans-serif;">

    <h2 style="margin:0; padding:18px 22px; background:#006eae; color:#fff; font-size:21px; border-radius:14px 14px 0 0;">
        Operadores aritméticos
    </h2>

    <div style="overflow-x:auto; border:1px solid #9cc8ff; border-top:none; border-radius:0 0 14px 14px; box-shadow:0 6px 20px rgba(0,110,174,.12);">
        <table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif;">

            <thead>
                <tr>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">Operador</th>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">Significado</th>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">Ejemplo</th>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">Resultado</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">+</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Suma
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>5 + 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        8
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">-</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Resta
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>10 - 4</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        6
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">*</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Multiplicación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>4 * 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        12
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">/</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        División
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>10 / 2</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        5
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">//</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        División entera
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>10 // 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        3
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">%</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Módulo (resto de la división)
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>10 % 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        1
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">**</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Potencia
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>2 ** 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        8
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">-x</code>
                    </td>
                    <td style="padding:13px 12px;">
                        Negación
                    </td>
                    <td style="padding:13px 12px;">
                        <code>-5</code>
                    </td>
                    <td style="padding:13px 12px; color:#006eae; font-weight:bold;">
                        -5
                    </td>
                </tr>

            </tbody>

        </table>
    </div>
</div>




tabla operadores de asignación 


Realizan una operación y almacenan su resultado en la variable inicial. Surgen de la unión del operador = y los operadores matemáticos.

<div style="width:100%; max-width:1000px; margin:30px auto; font-family:Arial, sans-serif;">

    <h2 style="margin:0; padding:18px 22px; background:#006eae; color:#fff; font-size:21px; border-radius:14px 14px 0 0;">
        Operadores de asignación
    </h2>

    <div style="overflow-x:auto; border:1px solid #9cc8ff; border-top:none; border-radius:0 0 14px 14px; box-shadow:0 6px 20px rgba(0,110,174,.12);">

        <table style="width:100%; border-collapse:collapse; font-family:Arial, sans-serif;">

            <thead>
                <tr>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">
                        Operador
                    </th>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">
                        Significado
                    </th>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">
                        Ejemplo
                    </th>
                    <th style="padding:14px 12px; background:#2b93d1; color:#fff; text-align:left;">
                        Equivalente a
                    </th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            =
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x = 5</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = 5
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            +=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Suma y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x += 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x + 3
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            -=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Resta y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x -= 2</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x - 2
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            *=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Multiplicación y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x *= 4</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x * 4
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            /=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        División y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x /= 2</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x / 2
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            //=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        División entera y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x //= 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x // 3
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            %=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Módulo y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x %= 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x % 3
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            **=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        Potencia y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x **= 2</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x ** 2
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            &amp;=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        AND bit a bit y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x &amp;= 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x &amp; 3
                    </td>
                </tr>

                <tr style="background:#f3f9ff;">
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            |=
                        </code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        OR bit a bit y asignación
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff;">
                        <code>x |= 3</code>
                    </td>
                    <td style="padding:13px 12px; border-bottom:1px solid #dceeff; color:#006eae; font-weight:bold;">
                        x = x | 3
                    </td>
                </tr>

                <tr>
                    <td style="padding:13px 12px;">
                        <code style="background:#9cc8ff; color:#003d61; padding:4px 8px; border-radius:6px;">
                            ^=
                        </code>
                    </td>
                    <td style="padding:13px 12px;">
                        XOR bit a bit y asignación
                    </td>
                    <td style="padding:13px 12px;">
                        <code>x ^= 3</code>
                    </td>
                    <td style="padding:13px 12px; color:#006eae; font-weight:bold;">
                        x = x ^ 3
                    </td>
                </tr>

            </tbody>

        </table>
    </div>
</div>
